{
  "targetDefaults": {
    "compile": {
      "dependsOn": [
        "^compile"
      ],
      "outputs": [
        "{projectRoot}/lib",
        "{projectRoot}/esm",
        "{projectRoot}/cache"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "compile"
      ],
      "outputs": [
        "{projectRoot}/target",
        "{projectRoot}/playwright-report",
        "{projectRoot}/test-results"
      ],
      "cache": true
    }
  },
  "analytics": false
}
