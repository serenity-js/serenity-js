{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "esModuleInterop": true,
    "lib": ["es2022", "dom"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
