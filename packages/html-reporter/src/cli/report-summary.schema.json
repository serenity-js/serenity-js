{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serenity-js.org/schemas/report-summary.json",
  "title": "Serenity/JS Report Summary",
  "description": "Machine-readable summary of an aggregated Serenity/JS HTML test report. Written as summary.json alongside the generated index.html. Designed for AI agents, CI bots, and custom tooling.",
  "type": "object",
  "required": ["generated", "title", "schemaVersion", "latestRun", "runs", "failureClusters", "consistency", "scores"],
  "properties": {
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this summary was generated"
    },
    "title": {
      "type": "string",
      "description": "Report title (from config or auto-detected)"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "latestRun": {
      "$ref": "#/$defs/RunInfo"
    },
    "runs": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of historical test runs in the report"
    },
    "failureClusters": {
      "type": "array",
      "description": "Failures grouped by error fingerprint. Empty array when all tests pass.",
      "items": {
        "$ref": "#/$defs/FailureCluster"
      }
    },
    "consistency": {
      "$ref": "#/$defs/Consistency"
    },
    "scores": {
      "$ref": "#/$defs/Scores"
    }
  },
  "$defs": {
    "RunInfo": {
      "type": "object",
      "description": "Summary of a single test run",
      "required": ["timestamp", "label", "totals", "duration"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the run started"
        },
        "label": {
          "type": "string",
          "description": "Human-readable run label (e.g. '#8300', '17 Jul 2026 14:50')"
        },
        "totals": {
          "$ref": "#/$defs/Totals"
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "description": "Total execution duration in milliseconds"
        }
      }
    },
    "Totals": {
      "type": "object",
      "description": "Outcome counts for the test run",
      "required": ["passed", "failed", "pending", "skipped", "compromised", "error"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "compromised": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 }
      }
    },
    "FailureCluster": {
      "type": "object",
      "description": "A group of scenarios sharing the same error fingerprint",
      "required": ["fingerprint", "errorType", "message", "scenarios"],
      "properties": {
        "fingerprint": {
          "type": "string",
          "description": "Stable identifier for this error group (normalised from error type + message)"
        },
        "errorType": {
          "type": "string",
          "description": "Error class/type name (e.g. 'AssertionError', 'TimeoutError')"
        },
        "message": {
          "type": "string",
          "description": "Normalised error message (ANSI stripped, absolute paths stripped, truncated to 200 chars)"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/FailureClusterScenario"
          }
        }
      }
    },
    "FailureClusterScenario": {
      "type": "object",
      "description": "A scenario within a failure cluster",
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Scenario name"
        },
        "source": {
          "type": "string",
          "description": "Source location as relative path:line (e.g. 'spec/login.spec.ts:42')"
        },
        "browser": {
          "type": "string",
          "description": "Browser/project identifier (e.g. 'chromium 149.0.7827.55')"
        },
        "failingStep": {
          "type": "string",
          "description": "Name of the deepest failing activity in the scenario's activity tree"
        }
      }
    },
    "Consistency": {
      "type": "object",
      "description": "Cross-run consistency classification counts",
      "required": ["flaky", "inconsistent", "degraded", "recovered"],
      "properties": {
        "flaky": {
          "type": "integer",
          "minimum": 0,
          "description": "Tests that pass only via retry (build green, test unreliable)"
        },
        "inconsistent": {
          "type": "integer",
          "minimum": 0,
          "description": "Tests whose final outcome differs across runs"
        },
        "degraded": {
          "type": "integer",
          "minimum": 0,
          "description": "Tests that were passing, now failing"
        },
        "recovered": {
          "type": "integer",
          "minimum": 0,
          "description": "Tests that were failing, now pass cleanly"
        }
      }
    },
    "Scores": {
      "type": "object",
      "description": "Composite quality scores (0–100)",
      "required": ["confidence", "passRate", "completeness", "consistency"],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Composite confidence score: passRate × 0.40 + completeness × 0.25 + consistency × 0.35"
        },
        "passRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of executed scenarios passing"
        },
        "completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of scenarios that are implemented (not pending/skipped)"
        },
        "consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Outcome repeatability across runs"
        }
      }
    }
  }
}
