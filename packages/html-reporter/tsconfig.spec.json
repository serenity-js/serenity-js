{
  "extends": "../../tsconfig.options.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "app/**/*.ts",
    "spec/**/*.ts",
    "playwright.config.ts"
  ]
}
