{
  "name": "@serenity-js/html-reporter",
  "version": "3.44.0",
  "description": "Serenity/JS HTML reporter that produces a self-contained static report with test results, trends, and execution history",
  "author": {
    "name": "Jan Molak",
    "email": "jan.molak@smartcodeltd.co.uk",
    "url": "https://janmolak.com"
  },
  "funding": {
    "url": "https://github.com/sponsors/serenity-js"
  },
  "homepage": "https://serenity-js.org",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "module": "./esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./lib/*": "./lib/*",
    "./esm/*": "./esm/*.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "automation",
    "integration",
    "serenity",
    "serenity-js",
    "screenplay",
    "screenplay-pattern",
    "reporter",
    "html",
    "report",
    "tdd",
    "bdd",
    "test",
    "testing"
  ],
  "scripts": {
    "clean": "rimraf target lib esm",
    "test": "c8 npm run test:no-coverage",
    "test:no-coverage": "mocha --config .mocharc.yml --spec='spec/**/*.spec.*'",
    "compile": "npm run compile:clean && npm run compile:esm && npm run compile:cjs-package && npm run compile:cjs && npm run compile:template",
    "compile:template": "node scripts/bundle-template.mjs",
    "compile:clean": "rimraf lib esm",
    "compile:esm": "tsc --project tsconfig-esm.build.json",
    "compile:cjs-package": "node -e \"require('fs').mkdirSync('lib', { recursive: true }); require('fs').writeFileSync('lib/package.json', '{ \\\"type\\\": \\\"commonjs\\\" }')\"",
    "compile:cjs": "tsc --project tsconfig-cjs.build.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/serenity-js/serenity-js.git",
    "directory": "packages/html-reporter"
  },
  "bugs": {
    "url": "https://github.com/serenity-js/serenity-js/issues"
  },
  "engines": {
    "node": ">=22.12 || ^24"
  },
  "peerDependencies": {
    "@serenity-js/core": "workspace:*"
  },
  "dependencies": {
    "marked": "14.0.0",
    "tiny-types": "2.0.5"
  },
  "devDependencies": {
    "@integration/testing-tools": "workspace:*",
    "@serenity-js/core": "workspace:*",
    "@tanstack/virtual-core": "3.13.6",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/sinon": "17.0.4",
    "c8": "11.0.0",
    "chart.js": "4.4.7",
    "chartjs-plugin-zoom": "2.2.0",
    "esbuild": "0.25.12",
    "hammerjs": "2.0.8",
    "htm": "3.1.1",
    "memfs": "4.57.7",
    "mocha": "11.7.6",
    "mocha-multi": "1.1.7",
    "preact": "10.25.4",
    "sinon": "19.0.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
